<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="kz.kzsigner"
    android:versionCode="1"
    android:versionName="0.1.0-dev">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />
    <!-- NCA's time stamps and revocation check -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="kzsigner"
        android:icon="@mipmap/ic_launcher"
        android:hasCode="true"
        android:allowBackup="false"
        android:extractNativeLibs="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|uiMode|density|locale|layoutDirection"
            android:windowSoftInputMode="adjustResize">
            <meta-data android:name="android.app.lib_name" android:value="kzsigner_android" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Open with kzsigner" for signatures, PDFs and keys; "Share" to kzsigner -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:mimeType="application/pkcs7-signature" />
                <data android:mimeType="application/pkcs7-mime" />
                <data android:mimeType="application/x-pkcs12" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <provider
            android:name=".SharedFiles"
            android:authorities="kz.kzsigner.files"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
