<?xml version="1.0" encoding="utf-8"?>
<!-- The test APK's own parts; package, runner and SDK levels come from build.gradle.kts -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- to switch the fake NCA servers on the test machine (10.0.2.2:18082, plain HTTP) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:usesCleartextTraffic="true">
        <!-- test key files (testdata/keys), opened in the Compose app as "Open with" does -->
        <provider
            android:name=".KeyFiles"
            android:authorities="kz.kzsigner.uitest.keys"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
